# Copiare come .env.local e inserire i valori reali. Non commettere .env.local.
OPENAI_API_KEY=
BREVO_API_KEY=

SIRACUSA_OPENAI_TIMEOUT=240
SIRACUSA_OPENAI_ATTEMPTS=3
SIRACUSA_BREVO_SENDER=newsletter@siracusadaily.com
SIRACUSA_BREVO_SENDER_NAME=SiracusaDaily
SIRACUSA_BREVO_REPLY_TO=ciao@siracusadaily.com

# Invio Brevo automatico. In produzione viene attivato soltanto nei run schedulati.
SIRACUSA_AUTO_SEND_ENABLED=false
SIRACUSA_BREVO_SEND_TIME=08:30
SIRACUSA_BREVO_MINIMUM_LEAD_MINUTES=15

# Link inserito nel primo commento del recap Facebook.
SIRACUSA_FACEBOOK_SIGNUP_URL=https://siracusadaily.com/?utm_source=facebook&utm_medium=organic&utm_campaign=recap_giornaliero#iscriviti

# Pubblicazione del recap nella pagina operativa Notion.
NOTION_TOKEN=
NOTION_FACEBOOK_PAGE_ID=3b9deac1-b022-8196-8a55-d77a97e81cf9

# Immagini della newsletter: disattivate in locale per impostazione predefinita.
# Per provarle, usare "remote" (nessun upload) oppure "netlify" con token.
SIRACUSA_IMAGE_MODE=off
SIRACUSA_IMAGE_UPLOAD_URL=https://siracusadaily.com/.netlify/functions/newsletter-image
SIRACUSA_IMAGE_PUBLIC_BASE=https://siracusadaily.com/.netlify/functions/newsletter-image
SIRACUSA_IMAGE_UPLOAD_TOKEN=
